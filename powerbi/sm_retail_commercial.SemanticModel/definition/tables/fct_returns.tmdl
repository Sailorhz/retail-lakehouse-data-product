		formatString: #,0.00
		summarizeBy: sum
		sourceColumn: financial_refund_eur

	column days_to_return
		dataType: int64
		summarizeBy: none
		sourceColumn: days_to_return

	partition fct_returns = entity
		mode: directLake
		source
			entityName: fct_returns
			schemaName: gold
			expressionSource: DatabaseQuery
