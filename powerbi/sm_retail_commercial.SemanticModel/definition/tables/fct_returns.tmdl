	column return_reason
		dataType: string
		summarizeBy: none
		sourceColumn: return_reason

	column item_condition
		dataType: string
		summarizeBy: none
		sourceColumn: item_condition

	column refund_status
		dataType: string
		summarizeBy: none
		sourceColumn: refund_status

	column is_financial_refund
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_financial_refund

	column returned_quantity
		dataType: int64
		summarizeBy: sum
		sourceColumn: returned_quantity

	column refund_currency_code
		dataType: string
		summarizeBy: none
