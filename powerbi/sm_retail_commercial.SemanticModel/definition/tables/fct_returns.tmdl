		sourceColumn: sales_line_key

	column order_number
		dataType: int64
		summarizeBy: none
		sourceColumn: order_number

	column line_item
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: line_item

	column return_date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: return_date_key

	column refund_date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: refund_date_key

	column order_date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: order_date_key

	column customer_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: customer_key

	column product_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: product_key

	column sale_store_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: sale_store_key

	column return_store_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: return_store_key

	column return_channel
		dataType: string
		summarizeBy: none
