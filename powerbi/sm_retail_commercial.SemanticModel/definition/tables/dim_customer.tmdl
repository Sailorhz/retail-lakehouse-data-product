table dim_customer

	column customer_key
		dataType: int64
		summarizeBy: none
		sourceColumn: customer_key

	column customer_name
		dataType: string
		summarizeBy: none
		sourceColumn: customer_name

	column gender
		dataType: string
		summarizeBy: none
		sourceColumn: gender

	column city
		dataType: string
		summarizeBy: none
		sourceColumn: city

	column state_code
		dataType: string
		summarizeBy: none
		sourceColumn: state_code

	column state
		dataType: string
		summarizeBy: none
		sourceColumn: state

	column zip_code
		dataType: string
		summarizeBy: none
		sourceColumn: zip_code

	column country
		dataType: string
		summarizeBy: none
		sourceColumn: country

	column continent
		dataType: string
		summarizeBy: none
		sourceColumn: continent

	column birth_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: birth_date

	partition dim_customer = entity
		mode: directLake
		source
			entityName: dim_customer
			schemaName: gold
			expressionSource: DatabaseQuery
