table dim_product

	column product_key
		dataType: int64
		summarizeBy: none
		sourceColumn: product_key

	column product_name
		dataType: string
		summarizeBy: none
		sourceColumn: product_name

	column brand
		dataType: string
		summarizeBy: none
		sourceColumn: brand

	column color
		dataType: string
		summarizeBy: none
		sourceColumn: color

	column unit_cost_usd
		dataType: decimal
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: unit_cost_usd

	column unit_price_usd
		dataType: decimal
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: unit_price_usd

	column subcategory_key
		dataType: int64
		summarizeBy: none
		sourceColumn: subcategory_key

	column subcategory
		dataType: string
		summarizeBy: none
		sourceColumn: subcategory

	column category_key
		dataType: int64
		summarizeBy: none
		sourceColumn: category_key

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	partition dim_product = entity
		mode: directLake
		source
			entityName: dim_product
			schemaName: gold
			expressionSource: DatabaseQuery
